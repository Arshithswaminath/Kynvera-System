# Flask / App
FLASK_ENV=development
# Empty-table ticketing/FM/team catalogs only. Does not insert sample HR/hiring rows.
# To fill dashboards with demo people, run: ./venv/bin/python scripts/seed_all_sample_data.py
# AUTO_SEED_DEMO_DATA=0
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-replace-me

# Database (Postgres)
DATABASE_URL=postgresql://username:password@localhost:5432/injaaz

# Redis (Upstash or local)
REDIS_URL=redis://localhost:6379

# Cloudinary (for client direct uploads and server uploads)
# Sign up at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# ── Google Drive (Files module sync) ─────────────────────────
# Leave disabled until OAuth credentials are ready. Local Files works without these.
GOOGLE_DRIVE_ENABLED=false
# GOOGLE_DRIVE_CLIENT_ID=
# GOOGLE_DRIVE_CLIENT_SECRET=
# Must match the authorized redirect URI in Google Cloud Console exactly:
# GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5002/files/api/drive/callback
# Production example:
# GOOGLE_DRIVE_REDIRECT_URI=https://your-service.onrender.com/files/api/drive/callback

# ── Automations (daily HR Excel backup at 8:00 PM Asia/Dubai) ──
# Comma-separated recipients used when a job has no recipients of its own.
# Files copies are always saved under Files → HR even if this is empty.
# AUTOMATION_BACKUP_TO=hr@example.com,ops@example.com
# In-process minute tick (default on). Set 0 on extra Gunicorn workers if you scale past 1.
# AUTOMATIONS_SCHEDULER=1
# AUTOMATION_SCHEDULE_TIMEZONE=Asia/Dubai
# Attach a branded PDF of the live Hiring / Leave / Manpower screens (needs Playwright).
# AUTOMATION_UI_SNAPSHOT=1
# AUTOMATION_SNAPSHOT_BASE_URL=http://127.0.0.1:5002

# Local dev server port (Flask listens here; production hosts set PORT automatically)
PORT=5002

# App base URL (used to construct absolute file links, emails, PWA — use public HTTPS URL on Render)
APP_BASE_URL=http://localhost:5002
# Optional. HTTPS PNG of the Kynvera wordmark in emails (faster than the app origin).
# EMAIL_WORDMARK_URL=https://res.cloudinary.com/your-cloud/image/upload/w_240,c_scale,f_png/kynvera/email-wordmark.png
# Local sends automatically use https://operations.kynvera.net/static/images/kynvera/kynvera-wordmark.png
# when APP_BASE_URL is localhost (inbox clients cannot load 127.0.0.1 images).
# Production product host (staff sign-in):
# APP_BASE_URL=https://operations.kynvera.net
# Public marketing site (kynvera-marketing branch on the home Render service):
# KYNVERA_MARKETING_ONLY=true
# KYNVERA_HOME_URL=https://kynvera.net
# APP_BASE_URL=https://operations.kynvera.net
# KYNVERA_MARKETING_HOSTS=kynvera.net,www.kynvera.net
# SESSION_COOKIE_SECURE=true when served only over HTTPS
# Do not link Sign in / Create account from kynvera.net. Give clients
# operations.kynvera.net privately. Close self-serve signup on the app:
# ALLOW_PUBLIC_REGISTRATION=false

# JWT config
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your-jwt-secret-key-here-replace-me

# JWT Token Expiry Settings (optional - defaults shown)
# JWT_ACCESS_HOURS: Number of hours access tokens are valid (default: 1)
# JWT_REFRESH_DAYS: Number of days refresh tokens are valid (default: 7)
# JWT_ACCESS_HOURS=1
# JWT_REFRESH_DAYS=7

# Rate Limiting (requests per hour)
RATELIMIT_STORAGE_URL=redis://localhost:6379
RATELIMIT_DEFAULT=100 per hour

# ── Email / SMTP ─────────────────────────────────────────────
# Required for Report Generation and password-reset emails.
# Pick ONE option below and uncomment / fill in .env (see docs/EMAIL_SMTP_OPTIONS.md).
#
# --- Recommended: Brevo HTTPS API (works on Render free tier; SMTP ports blocked) ---
# Sign up: https://app.brevo.com → Settings → SMTP & API → API Keys
# BREVO_API_KEY=xkeysib-...
# MAIL_DEFAULT_SENDER=support@kynvera.store
# Local send: if logs show "unrecognised IP", add this laptop at
# https://app.brevo.com/security/authorised_ips (Render is already allowed).
#
# --- Brevo SMTP (local or paid Render) ---
# MAIL_SERVER=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-brevo-login-email
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_DEFAULT_SENDER=noreply@injaaz.ae
#
# --- Mailjet HTTPS API ---
# Sign up: https://www.mailjet.com → Account → SMTP & API
# MAILJET_API_KEY=your-mailjet-api-key
# MAILJET_SECRET_KEY=your-mailjet-secret-key
# MAIL_DEFAULT_SENDER=noreply@injaaz.ae
#
# --- Mailjet SMTP (local dev or Render paid) ---
# MAIL_SERVER=in-v3.mailjet.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=your-mailjet-api-key
# MAIL_PASSWORD=your-mailjet-secret-key
# MAIL_DEFAULT_SENDER=noreply@injaaz.ae
#
# --- SendGrid (free 100/day for 60 days, then paid) ---
# Sign up: https://sendgrid.com → Settings → API Keys → Create (Mail Send)
# MAIL_SERVER=smtp.sendgrid.net
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=your-sendgrid-api-key
# MAIL_DEFAULT_SENDER=noreply@injaaz.ae
#
# --- Personal Gmail / Workspace / Microsoft 365 SMTP ---
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=yourname@gmail.com
# MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
# MAIL_DEFAULT_SENDER=yourname@gmail.com

# ── Ticket email intake (Mailjet Parse API) ──────────────────
# See docs/TICKET_EMAIL_INTAKE_SETUP.md
# TICKET_INBOUND_WEBHOOK_SECRET=<long-random-string>
# TICKET_INTAKE_EMAIL=support@kynvera.store

# ── Injaaz Assistant (optional natural chat — Claude recommended) ──
# Get key: https://console.anthropic.com/settings/keys
# ASSISTANT_LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_LLM_MODEL=claude-haiku-4-5
# ASSISTANT_LLM_ENABLED=true
#
# OpenAI alternative:
# ASSISTANT_LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# ASSISTANT_LLM_MODEL=gpt-4o-mini
